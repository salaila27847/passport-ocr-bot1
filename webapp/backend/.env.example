# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (.env อยู่ใน .gitignore แล้ว ไม่มีทาง commit หลุด)
# ขั้นตอนขอค่าแต่ละตัวดูได้ที่ webapp/README.md หัวข้อ "สิ่งที่ต้องตั้งค่าเอง"

# เนื้อหาไฟล์ JSON ของ Google Cloud service account ทั้งก้อน (วางเป็นบรรทัดเดียว)
# ใช้สำหรับอ่าน/เขียน Google Sheets + Drive — ต้องแชร์สิทธิ์ Editor ให้อีเมลใน client_email ของไฟล์นี้ด้วย
GOOGLE_SERVICE_ACCOUNT_JSON=

# ชื่อโฟลเดอร์ Drive หลักที่เก็บทั้ง Google Sheet และรูปถ่าย — ใส่เฉพาะถ้าไม่ได้ใช้ชื่อ "interview"
MAIN_FOLDER_NAME=interview

# API key ของ Typhoon OCR จาก opentyphoon.ai — ไม่ใส่ก็ได้ ระบบจะ fallback ไปใช้ PassportEye อย่างเดียว
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1

# Client ID จาก Google Cloud > APIs & Services > Credentials > OAuth client ID (ไม่ใช่ secret ใส่ตรงๆ ได้)
GOOGLE_OAUTH_CLIENT_ID=

# ใครมีสิทธิ์เข้าระบบได้บ้าง — ตั้งอย่างน้อย 1 ตัว ไม่ตั้งเลย = ปฏิเสธทุกคน (fail closed)
# ใส่ได้ทั้งคู่พร้อมกันถ้าต้องการ (เช่น คนในโดเมนองค์กร + อีเมลส่วนตัวบางคน)
ALLOWED_STAFF_DOMAIN=
ALLOWED_STAFF_EMAILS=
